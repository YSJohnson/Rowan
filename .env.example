# ===========================================================================
# Rowan 本地开发/演示配置模板（仅 debug 构建注入，release 不读）
# 用法：cp .env.example .env，然后填入你自己的值。.env 已 gitignore 不会提交。
# 构建时由 app/build.gradle.kts 读取 -> BuildConfig.ENV_* -> DebugConfigSeeder 预填。
# ===========================================================================

# ===== 云端 LLM（对话体）=====
# 默认启动的 Provider 和模型
# Provider：GLM / KIMI / MODELSCOPE / OPENAI_COMPATIBLE
# - GLM:        https://open.bigmodel.cn/api/anthropic  (open.bigmodel.cn 申请)
# - KIMI:       https://api.kimi.com/coding
# - MODELSCOPE: https://api-inference.modelscope.cn     (魔搭)
# - OPENAI_COMPATIBLE: 任意 OpenAI 兼容端点，配合 LLM_BASE_URL 使用
LLM_PROVIDER=MODELSCOPE
LLM_MODEL=Qwen/Qwen3.5-397B-A17B
# OpenAI 兼容示例：LLM_PROVIDER=OPENAI_COMPATIBLE，LLM_MODEL=服务商模型 ID
LLM_BASE_URL=

# 各 Provider 密钥（同时注入，切换时自动加载）
GLM_API_KEY=
MODELSCOPE_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=

# ===== 预填策略 =====
# true=每次 debug 启动强制用 .env 覆盖 DataStore
# false（默认）=只在字段为空时填，不破坏运行时手改的值
ENV_FORCE_SEED=false
